/* Rollmark's badges: B(id, name, description, family, test). Included by roll.c (and roll.h for the ids).
 * Each test reads the integer part through `f` (see feat_t in roll.c). Order = display order on a roll.
 * Most tests are the pattern ideas of RNGidle's original badges (simple facts about digits); names, wording and
 * prices are Rollmark's own, prices from exact odds (tools/odds.c). Families: only the best earned one pays. */

/* ---- endings */
B(TAIL1, "Round Off", "Ends in 0.", F_TAIL, f->v && ends(f, "0"))
B(TAIL2, "Double Round", "Ends in 00.", F_TAIL, f->v && ends(f, "00"))
B(TAIL3, "Triple Round", "Ends in 000.", F_TAIL, f->v && ends(f, "000"))
B(TAIL4, "Blank Check", "Ends in 0000.", F_TAIL, f->v && ends(f, "0000"))
B(TAIL5, "Clean Sweep", "Ends in 00000.", F_TAIL, f->v && ends(f, "00000"))
B(END5, "Halfway", "Ends in 5.", F_FIVES, ends(f, "5"))
B(END50, "Fifty-Fifty", "Ends in 50.", F_FIVES, ends(f, "50"))
B(END500, "Half Grand", "Ends in 500.", F_FIVES, ends(f, "500"))
B(END5000, "Five Grand", "Ends in 5000.", F_FIVES, ends(f, "5000"))
B(END50000, "Fifty Grand", "Ends in 50000.", F_FIVES, ends(f, "50000"))
B(END25, "Quarter", "Ends in 25.", F_QUARTER, ends(f, "25"))
B(END75, "Three Quarters", "Ends in 75.", F_QUARTER, ends(f, "75"))
B(END99, "Almost", "Ends in 99.", F_NINES, ends(f, "99"))
B(END999, "Nearly There", "Ends in 999.", F_NINES, ends(f, "999"))
B(END9999, "So Close", "Ends in 9999.", F_NINES, ends(f, "9999"))
B(END99999, "Agonizing", "Ends in 99999.", F_NINES, ends(f, "99999"))
B(HOLE2, "Gap", "Contains 00.", F_HOLES, has(f, "00"))
B(HOLE3, "Hole", "Contains 000.", F_HOLES, has(f, "000"))
B(HOLE4, "Pit", "Contains 0000.", F_HOLES, has(f, "0000"))
B(HOLE5, "Abyss", "Contains 00000.", F_HOLES, has(f, "00000"))

/* ---- size */
B(LITTLE, "Pocket Size", "Under 1,000.", F_SMALL, f->v < 1000)
B(TINY, "Crumb", "Under 100.", F_SMALL, f->v < 100)
B(ATOM, "Speck", "A single digit.", F_SMALL, f->n == 1)
B(NOTHING, "Hollow", "Exactly zero.", F_SMALL, f->v == 0)
B(TOP_SHELF, "Top Shelf", "Greater than 999,000.", F_NONE, f->v > 999000)
B(HIGH, "High Roller", "Starts with 9.", F_NONE, f->n >= 2 && f->d[0] == '9')
B(LOW, "Underdog", "Starts with 1.", F_NONE, f->n >= 2 && f->d[0] == '1')

/* ---- which digits */
B(NO_ZERO, "Zeroless", "Contains no zeros.", F_NONE, !f->cnt[0])
B(BITS, "Machine Code", "Only 0s and 1s (3+ digits).", F_NONE, f->n >= 3 && f->cnt[0] + f->cnt[1] == f->n)
B(ALL_DIFF, "No Twins", "No digit repeated (3+ digits).", F_NONE, f->n >= 3 && f->distinct == f->n)
B(TWO_TONE, "Two-Tone", "Only two different digits (4+ digits).", F_NONE, f->n >= 4 && f->distinct == 2)
B(EVENS, "Even Keel", "Only even digits (3+ digits).", F_NONE, f->n >= 3 && f->odd == 0)
B(ODDS, "Odd Lot", "Only odd digits (3+ digits).", F_NONE, f->n >= 3 && f->odd == f->n)
B(LOW_DIGITS, "Low Tide", "Only digits from 0 to 4 (3+ digits).", F_NONE, f->n >= 3 && only(f, "01234"))
B(HIGH_DIGITS, "High Tide", "Only digits from 5 to 9 (3+ digits).", F_NONE, f->n >= 3 && only(f, "56789"))
B(TRIAD, "Triad", "Every digit is 0, 3, 6 or 9 (3+ digits).", F_NONE, f->n >= 3 && only(f, "0369"))
B(BALANCED, "Balanced", "Its two halves have the same digit sum.", F_NONE, f->n >= 2 && f->n % 2 == 0 && half_sums_equal(f))
B(LONE0, "Lone Zero", "Exactly one 0.", F_LONE, f->cnt[0] == 1)
B(LONE1, "Lone One", "Exactly one 1.", F_LONE, f->cnt[1] == 1)
B(LONE2, "Lone Two", "Exactly one 2.", F_LONE, f->cnt[2] == 1)
B(LONE3, "Lone Three", "Exactly one 3.", F_LONE, f->cnt[3] == 1)
B(LONE4, "Lone Four", "Exactly one 4.", F_LONE, f->cnt[4] == 1)
B(LONE5, "Lone Five", "Exactly one 5.", F_LONE, f->cnt[5] == 1)
B(LONE6, "Lone Six", "Exactly one 6.", F_LONE, f->cnt[6] == 1)
B(LONE7, "Lone Seven", "Exactly one 7.", F_LONE, f->cnt[7] == 1)
B(LONE8, "Lone Eight", "Exactly one 8.", F_LONE, f->cnt[8] == 1)
B(LONE9, "Lone Nine", "Exactly one 9.", F_LONE, f->cnt[9] == 1)

/* ---- repeats */
B(MATCHED, "Matched", "Some digit appears twice.", F_PAIRS, f->maxcnt >= 2)
B(TWO_PAIR, "Two Pair", "Two different digits each appear twice.", F_PAIRS, f->pairs >= 2)
B(THREE_PAIR, "Three Pair", "Three different digits each appear twice.", F_PAIRS, f->pairs >= 3)
B(TRIPS, "Trips", "A digit appears three times.", F_KIND, f->maxcnt >= 3)
B(QUADS, "Quads", "A digit appears four times.", F_KIND, f->maxcnt >= 4)
B(HANDFUL, "Handful", "A digit appears five times.", F_KIND, f->maxcnt >= 5)
B(FULL_HOUSE, "Full House", "Three of one digit and two of another.", F_HOUSE, full_house(f))
B(PACKED_HOUSE, "Packed House", "A run of three next to a run of two, like 77744.", F_HOUSE, packed_house(f))
B(RUN2, "Doublet", "The same digit twice in a row.", F_RUN, f->maxrun >= 2)
B(RUN3, "Stutter", "One digit three times in a row.", F_RUN, f->maxrun >= 3)
B(RUN4, "Drumroll", "One digit four times in a row.", F_RUN, f->maxrun >= 4)
B(RUN5, "Broken Record", "One digit five times in a row.", F_RUN, f->maxrun >= 5)
B(RUN6, "Stuck Key", "One digit six times in a row.", F_RUN, f->maxrun >= 6)
B(AABB, "Double Doublet", "Two doubles side by side, like 3388.", F_ADJPAIRS, adj_pairs(f, 2))
B(AABBCC, "Triple Doublet", "Three doubles side by side, like 113355.", F_ADJPAIRS, adj_pairs(f, 3))
B(MONOTONE, "Monotone", "Every digit the same (2+ digits).", F_NONE, f->n >= 2 && f->distinct == 1)
B(ODD_ONE, "Odd One Out", "All the same digit but one (3+ digits).", F_NONE, f->n >= 3 && f->distinct == 2 && f->maxcnt == f->n - 1)
B(LONELY_ONES, "Lonely Ones", "One pair of 1s and no other pair.", F_NONE, f->cnt[1] == 2 && f->pairs == 1 && f->maxcnt == 2)
B(XYXY, "Repeat Offender", "Two digits repeated right away, like 4545.", F_NONE, xyxy(f))
B(DEJA_VU, "Deja Vu", "The same 2+ digits appear twice.", F_NONE, repeated_chunk(f))
B(SANDWICH, "Sandwich", "Five digits: a triple between two others.", F_NONE, f->n == 5 && sandwich(f, 1, 3))
B(CLUB, "Club Sandwich", "Six digits: four of a kind between two others.", F_NONE, f->n == 6 && sandwich(f, 1, 4))
B(LAYER_CAKE, "Layer Cake", "Six digits: two pairs between two others.", F_NONE, f->n == 6 && layer_cake(f))
B(SEVEN, "Lucky Seven", "Has a 7 in it.", F_SEVENS, f->cnt[7] > 0)
B(JACKPOT, "Jackpot", "Contains 777.", F_SEVENS, has(f, "777"))
B(TRIPLE7, "Triple Seven", "Exactly 777.", F_SEVENS, is(f, "777"))
B(SEVEN4, "Lucky Streak", "Four 7s in a row.", F_SEVENS, has(f, "7777"))
B(SEVEN5, "Hot Streak", "Five 7s in a row.", F_SEVENS, has(f, "77777"))
B(SEVEN6, "Seventh Heaven", "Six 7s in a row.", F_SEVENS, has(f, "777777"))
B(UNLUCKY, "Unlucky", "Contains 13.", F_NONE, has(f, "13"))

/* ---- sequences */
B(RISE, "Upstairs", "Three digits climbing by one, like 456.", F_STEP, f->up >= 3)
B(FALL, "Downstairs", "Three digits falling by one, like 654.", F_STEP, f->down >= 3)
B(LONG_STEP, "Escalator", "Five digits climbing or falling by one.", F_STEP, f->up >= 5 || f->down >= 5)
B(LEAPFROG, "Leapfrog", "Contains 02468 or 13579, either way.", F_NONE, has(f, "02468") || has(f, "13579") || has(f, "86420") || has(f, "97531"))
B(ROYAL, "Royal Straight", "Contains 56789.", F_NONE, has(f, "56789"))
B(SMALL_STRAIGHT, "Small Straight", "Three neighbours that sort into a run, like 425.", F_NONE, small_straight(f))
B(STRAIGHT, "Scrambled Straight", "All its digits sort into a run (3+ digits).", F_NONE, f->n >= 3 && f->distinct == f->n && f->maxd - f->mind == f->n - 1)
B(CLOSE_CALL, "Close Call", "Two of its digits are one apart.", F_NONE, close_call(f))

/* ---- shape */
B(MIRROR, "Reflection", "Reads the same both ways (2+ digits).", F_MIRROR, f->n >= 2 && f->pal)
B(GRAND_MIRROR, "Hall of Mirrors", "Reads the same both ways (6+ digits).", F_MIRROR, f->n >= 6 && f->pal)
B(HIDDEN_MIRROR, "Hidden Mirror", "Contains 4+ digits that read the same both ways.", F_MIRROR, hidden_palindrome(f))
B(UPSIDE_DOWN, "Headstand", "Looks the same upside down (0, 1, 8 stay; 6 and 9 swap).", F_NONE, upside_down(f))
B(UPHILL, "Uphill", "First digit smaller than the last.", F_ENDS, f->n >= 2 && f->d[0] < f->d[f->n - 1])
B(DOWNHILL, "Downhill", "First digit larger than the last.", F_ENDS, f->n >= 2 && f->d[0] > f->d[f->n - 1])
B(FULL_CIRCLE, "Full Circle", "First and last digits are the same.", F_ENDS, f->n >= 2 && f->d[0] == f->d[f->n - 1])
B(BOOKENDS, "Bookends", "Same first and last digit, something else between.", F_ENDS, bookends(f))
B(NEAR_MISS, "Near Miss", "First and last digits are one apart.", F_ENDS2, f->n >= 2 && (f->d[0] - f->d[f->n - 1] == 1 || f->d[f->n - 1] - f->d[0] == 1))
B(FRAME, "Frame", "Starts and ends with the same two digits.", F_FRAME, f->n >= 4 && f->d[0] == f->d[f->n - 2] && f->d[1] == f->d[f->n - 1])
B(FLIP_FRAME, "Flip Frame", "Its first two digits come back reversed at the end.", F_FRAME, f->n >= 4 && f->d[0] != f->d[1] && f->d[0] == f->d[f->n - 1] && f->d[1] == f->d[f->n - 2])
B(PAIR_ENDS, "Double Bookends", "Starts with a pair, ends with another pair.", F_FRAME, f->n >= 4 && f->d[0] == f->d[1] && f->d[f->n - 2] == f->d[f->n - 1] && f->d[0] != f->d[f->n - 1])
B(ECHO, "Echo", "Its two halves are the same, like 123123.", F_NONE, f->n >= 4 && f->n % 2 == 0 && !memcmp(f->d, f->d + f->n / 2, f->n / 2))
B(ASCENT, "Ascent", "Every digit larger than the one before (3+ digits).", F_UP, f->n >= 3 && f->shape_up == f->n - 1)
B(NEVER_DOWN, "Never Down", "No digit smaller than the one before (3+ digits).", F_UP, f->n >= 3 && f->shape_down == 0)
B(DESCENT, "Descent", "Every digit smaller than the one before (3+ digits).", F_DOWN, f->n >= 3 && f->shape_down == f->n - 1)
B(NEVER_UP, "Never Up", "No digit larger than the one before (3+ digits).", F_DOWN, f->n >= 3 && f->shape_up == 0)
B(STAIRCASE, "Staircase", "Each digit one more than the last, like 3456.", F_UP2, f->n >= 3 && f->up == f->n)
B(COUNTDOWN, "Countdown", "Each digit one less than the last, like 6543.", F_DOWN2, f->n >= 3 && f->down == f->n)
B(SMOOTH, "Smooth", "Neighbouring digits never differ by more than 1.", F_NONE, f->n >= 3 && f->maxstep <= 1)
B(EVEN_STEPS, "Even Steps", "Digits evenly spaced, like 1357 (3+ digits).", F_SPACING, f->n >= 3 && arithmetic_digits(f, false))
B(BOUNCER, "Bouncer", "Every step the same size, up or down, like 3535 or 1357.", F_SPACING, f->n >= 3 && arithmetic_digits(f, true))
B(MOUNTAIN, "Mountain", "Digits climb to a peak, then fall.", F_PEAK, peak(f, 1, true))
B(HILL, "Hill", "Digits climb, then fall (flat bits allowed).", F_PEAK, peak(f, 1, false))
B(VALLEY, "Valley", "Digits fall to a trough, then climb.", F_TROUGH, peak(f, -1, true))
B(DIP, "Dip", "Digits fall, then climb (flat bits allowed).", F_TROUGH, peak(f, -1, false))
B(ZIGZAG, "Zigzag", "Up, down, up, down... every step (3+ digits).", F_ZIG, zigzag(f, true))
B(WOBBLE, "Wobble", "Ups and downs keep taking turns (flat bits allowed).", F_ZIG, zigzag(f, false))
B(CHECKER, "Checkerboard", "Even and odd digits take turns (3+ digits).", F_NONE, f->n >= 3 && checker(f))
B(PING_PONG, "Ping Pong", "Two digits taking turns, like 3737.", F_NONE, f->n >= 4 && ping_pong(f))
B(SKIP2, "Skip", "A digit comes back two places later, like 4x4.", F_SKIP, skip(f, 2))
B(SKIP3, "Hopscotch", "A digit at every other place three times, like 4x4x4.", F_SKIP, skip(f, 3))

/* ---- arithmetic */
B(EVEN, "Even", "Divisible by 2.", F_PARITY, !(f->v & 1))
B(ODD, "Odd", "Not divisible by 2.", F_PARITY, f->v & 1)
B(DIV7, "Week", "Divisible by 7.", F_NONE, f->v && f->v % 7 == 0)
B(DIV11, "Elevens", "Divisible by 11.", F_NONE, f->v && f->v % 11 == 0)
B(DIV12, "Dozen", "Divisible by 12.", F_NONE, f->v && f->v % 12 == 0)
B(PRIME, "Indivisible", "A prime number.", F_PRIME, f->prime)
B(TWIN, "Prime Pair", "A prime, 2 away from another prime.", F_PRIME, f->prime && ((f->v > 2 && is_prime64(f->v - 2)) || is_prime64(f->v + 2)))
B(SQUARE, "Tiled", "A perfect square.", F_POWER, f->v > 1 && is_power(f->v, 2))
B(CUBE, "Boxed", "A perfect cube.", F_POWER, f->v > 1 && is_power(f->v, 3))
B(POW4, "Hypercube", "A perfect 4th power.", F_POWER, f->v > 1 && is_power(f->v, 4))
B(POW5, "Quintic", "A perfect 5th power.", F_POWER, f->v > 1 && is_power(f->v, 5))
B(POW6, "Sextic", "A perfect 6th power.", F_POWER, f->v > 1 && is_power(f->v, 6))
B(POW7, "Septic", "A perfect 7th power.", F_POWER, f->v > 1 && is_power(f->v, 7))
B(POW8, "Octic", "A perfect 8th power.", F_POWER, f->v > 1 && is_power(f->v, 8))
B(POW9, "Nonic", "A perfect 9th power.", F_POWER, f->v > 1 && is_power(f->v, 9))
B(POW10, "Decic", "A perfect 10th power.", F_POWER, f->v > 1 && is_power(f->v, 10))
B(POW11, "Power Eleven", "A perfect 11th power.", F_POWER, f->v > 1 && is_power(f->v, 11))
B(POW13, "Power Thirteen", "A perfect 13th power.", F_POWER, f->v > 1 && is_power(f->v, 13))
B(POW17, "Power Seventeen", "A perfect 17th power.", F_POWER, f->v > 1 && is_power(f->v, 17))
B(POW19, "Power Nineteen", "A perfect 19th power.", F_POWER, f->v > 1 && is_power(f->v, 19))
B(BASE2, "Doubler", "A power of two.", F_BASE, power_of(f->v, 2))
B(BASE3, "Tripler", "A power of three.", F_BASE, power_of(f->v, 3))
B(BASE5, "Fiver", "A power of five.", F_BASE, power_of(f->v, 5))
B(BASE7, "Sevener", "A power of seven.", F_BASE, power_of(f->v, 7))
B(SELF_POWER, "Self-Powered", "A number to its own power: 1, 4, 27, 256...", F_NONE, self_power(f->v))
B(FACTORIAL, "Bang!", "A factorial: 1, 2, 6, 24, 120...", F_NONE, factorial(f->v))
B(SPIRAL, "Seashell", "A Fibonacci number.", F_NONE, f->v > 3 && is_fib(f->v))
B(TRIANGLE, "Bowling Pins", "A triangular number (1+2+3...).", F_NONE, f->v > 3 && is_square(8 * f->v + 1))
B(PRONIC, "Rectangle", "Two neighbours multiplied: k x (k+1).", F_NONE, f->v > 0 && pronic(f->v))
B(SELF_DIV, "Self-Made", "Divisible by the sum of its digits.", F_NONE, f->n >= 2 && f->sum && f->v % (uint64_t)f->sum == 0)
B(SUM_PROD, "Fair Trade", "Its digit sum equals its digit product.", F_NONE, f->n >= 2 && (uint64_t)f->sum == f->prod)
B(HEAVY, "Heavyweight", "Digit sum over 45.", F_NONE, f->sum > 45)
B(LIGHT, "Featherweight", "Digit sum under 15.", F_NONE, f->sum < 15)
B(BLACKJACK, "Blackjack", "Digit sum exactly 21.", F_NONE, f->sum == 21)

/* ---- splits */
B(EQUATION, "Equation", "Add one of + - x / and an = to make it true, like 12+3=15.", F_NONE, equation(f))
B(SPLIT2, "Neighbours", "Splits into two numbers in a row, like 89|90.", F_SPLIT, consecutive_split(f, 2, 0))
B(SPLIT3_MIX, "Jumbled Count", "Splits into three numbers in a row, out of order.", F_SPLIT, consecutive_split(f, 3, 2))
B(SPLIT3, "Count Up", "Splits into three numbers in a row, in order, like 9|10|11.", F_SPLIT, consecutive_split(f, 3, 1))
B(SPLIT4_MIX, "Shuffled Deck", "Splits into four numbers in a row, out of order.", F_SPLIT, consecutive_split(f, 4, 2))
B(SPLIT4, "Roll Call", "Splits into four numbers in a row, in order.", F_SPLIT, consecutive_split(f, 4, 1))
B(NEXT_DOOR, "Next Door", "Two side-by-side chunks of 2+ digits are one apart, like 4142.", F_CHUNKS, chunks_one_apart(f, true))
B(ACROSS, "Across the Street", "Two separate chunks of 2+ digits are one apart.", F_CHUNKS, chunks_one_apart(f, false))
B(ARITH_SPLIT, "Arithmetic", "Splits into 3+ numbers with the same gap, like 3|7|11.", F_PROGRESS, progression_split(f, false))
B(GEOM_SPLIT, "Geometric", "Splits into 3+ numbers with the same ratio, like 2|6|18.", F_PROGRESS, progression_split(f, true))

/* ---- famous numbers */
B(ANSWER, "Deep Thought", "Contains 42.", F_42, has(f, "42"))
B(ANSWER_X, "The Answer", "Exactly 42.", F_42, is(f, "42"))
B(ANSWER2, "Answer Twice", "Contains 4242.", F_42, has(f, "4242"))
B(ANSWER3, "Ultimate Answer", "Exactly 424242.", F_42, is(f, "424242"))
B(BEAST, "Beastly", "Contains 666.", F_666, has(f, "666"))
B(BEAST_X, "Number of the Beast", "Exactly 666.", F_666, is(f, "666"))
B(BEAST2, "Beast Mode", "Exactly 666666.", F_666, is(f, "666666"))
B(LEET, "Elite", "Contains 1337.", F_1337, has(f, "1337"))
B(LEET_X, "Elite Hacker", "Exactly 1337.", F_1337, is(f, "1337"))
B(HELL, "Upside Hell", "Contains 7734 (HELL upside down).", F_7734, has(f, "7734"))
B(HELL_X, "Hellbent", "Exactly 7734.", F_7734, is(f, "7734"))
B(HELLO, "Upside Hello", "Contains 07734 (HELLO upside down).", F_7734, has(f, "07734"))
B(SOS, "Emergency", "Contains 911.", F_911, has(f, "911"))
B(SOS_X, "Dispatch", "Exactly 911.", F_911, is(f, "911"))
B(SOS2, "Double Emergency", "Exactly 911911.", F_911, is(f, "911911"))
B(MISSING, "Not Found", "Contains 404.", F_404, has(f, "404"))
B(MISSING_X, "Page Missing", "Exactly 404.", F_404, is(f, "404"))
B(LONG_GAME, "The Long Game", "Exactly 17776.", F_NONE, is(f, "17776"))
B(AGENT, "Licensed", "Contains 007.", F_NONE, has(f, "007"))
B(ORWELL, "Big Brother", "Contains 1984.", F_1984, has(f, "1984"))
B(ORWELL_X, "Thoughtcrime", "Exactly 1984.", F_1984, is(f, "1984"))
B(SIX7, "Six Seven", "Contains 67.", F_67, has(f, "67"))
B(SIX7_X, "Just 67", "Exactly 67.", F_67, is(f, "67"))
B(SIX7_2, "Six Seven Twice", "Contains 6767.", F_67, has(f, "6767"))
B(SIX7_3, "Six Seven Forever", "Exactly 676767.", F_67, is(f, "676767"))
B(OUT, "Eighty-Sixed", "Contains 86.", F_86, has(f, "86"))
B(OUT_X, "Off the Menu", "Exactly 86.", F_86, is(f, "86"))
B(INTRO, "Intro Course", "Contains 101.", F_101, has(f, "101"))
B(INTRO_X, "Day One", "Exactly 101.", F_101, is(f, "101"))
B(YEAR, "Every Day", "Contains 365.", F_365, has(f, "365"))
B(YEAR_X, "One Year", "Exactly 365.", F_365, is(f, "365"))
B(YEAR2, "Two Years", "Exactly 365365.", F_365, is(f, "365365"))
B(ALWAYS, "Always Open", "Exactly 247365 or 365247.", F_365, is(f, "247365") || is(f, "365247"))
B(DAY, "One Day", "Exactly 86400, the seconds in a day.", F_NONE, is(f, "86400"))
B(MILLION, "Millionaire", "Exactly one million.", F_NONE, is(f, "1000000"))
B(PI3, "Circle", "Contains 314.", F_PI, has(f, "314"))
B(PI4, "Round Table", "Contains 3141.", F_PI, has(f, "3141"))
B(PI5, "Perfect Circle", "Contains 31415.", F_PI, has(f, "31415"))
B(PI_X, "Pi", "Exactly pi: 314, 3141, 31415 or 314159.", F_PI, is(f, "314") || is(f, "3141") || is(f, "31415") || is(f, "314159"))
B(E3, "Growth", "Contains 271.", F_E, has(f, "271"))
B(E4, "Natural", "Contains 2718.", F_E, has(f, "2718"))
B(E5, "Compound", "Contains 27182.", F_E, has(f, "27182"))
B(E_X, "Euler", "Exactly e: 271, 2718, 27182 or 271828.", F_E, is(f, "271") || is(f, "2718") || is(f, "27182") || is(f, "271828"))
B(TAU4, "Full Turn", "Contains 6283.", F_TAU, has(f, "6283"))
B(TAU5, "Revolution", "Contains 62831.", F_TAU, has(f, "62831"))
B(TAU_X, "Tau", "Exactly tau: 6283, 62831 or 628318.", F_TAU, is(f, "6283") || is(f, "62831") || is(f, "628318"))
B(PHI4, "Golden", "Contains 1618.", F_PHI, has(f, "1618"))
B(PHI_X, "Golden Ratio", "Exactly phi: 1618, 16180 or 161803.", F_PHI, is(f, "1618") || is(f, "16180") || is(f, "161803"))

/* ---- beyond the seed: sign, growth, fraction (odds from the draw model) */
B(BELOW_ZERO, "Below Zero", "A negative number (1 roll in 20).", F_NONE, f->neg)
B(GROW7, "Overgrown", "Grew to 7 digits or more.", F_GROW, f->n >= 7)
B(GROW8, "Sprawling", "Grew to 8 digits or more.", F_GROW, f->n >= 8)
B(GROW9, "Colossal", "Grew to 9 digits or more.", F_GROW, f->n >= 9)
B(GROW11, "Endless", "Grew to 11 digits or more.", F_GROW, f->n >= 11)
B(SHARD, "Shard", "Has decimals (1 roll in 100).", F_FRAC, f->fn >= 1)
B(SPLINTER, "Splinter", "2+ decimals.", F_FRAC, f->fn >= 2)
B(SLIVER, "Sliver", "3+ decimals.", F_FRAC, f->fn >= 3)
B(DUST, "Stardust", "4+ decimals.", F_FRAC, f->fn >= 4)
