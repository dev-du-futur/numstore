{
  "name": "numstore",
  "productName": "Numstore",
  "version": "0.2.1",
  "description": "Install and remove apps on your NumWorks calculator",
  "main": "src/main.js",
  "author": "Awe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "catalog": "node scripts/build-catalog.js",
    "icon": "python scripts/make_icon.py",
    "dist": "node scripts/build-catalog.js && electron-builder --win --publish never",
    "release": "node scripts/build-catalog.js && electron-builder --win --publish always",
    "dist:mac": "node scripts/build-catalog.js && electron-builder --mac --publish never"
  },
  "dependencies": {
    "cli-progress": "^3.11.2",
    "commander": "^9.3.0",
    "electron-updater": "^6.8.11",
    "tar-stream": "^3.2.2",
    "usb": "2.4.3"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.devdufutur.numstore",
    "productName": "Numstore",
    "copyright": "Awe",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json",
      "!src/**/*.map"
    ],
    "extraResources": [
      {
        "from": "catalog",
        "to": "catalog"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Numstore-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Numstore"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dev-du-futur",
        "repo": "numstore",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "Numstore-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Numstore ${version}"
    },
    "afterPack": "scripts/after-pack.js",
    "npmRebuild": false
  }
}
